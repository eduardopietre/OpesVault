# ── Empacotamento (Nuitka / pyside6-deploy) ────────────
*.build/
*.dist/
*.onefile-build/
deployment/
*.exe
*.msi
*.pyd
*.dll

# ── Dados sensíveis: NUNCA versionar ───────────────────
# Cofres, candidatos de gravação, backups e bloqueios
*.opesvault
*.opesvault.*
*.opesvault-*
*.bak
# Bancos locais (cifrados ou não)
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlcipher
# Documentos financeiros: só PDFs sintéticos explicitamente liberados
*.pdf
!tests/fixtures/sinteticos/**/*.pdf
# Notas anonimizadas de terceiros, auditadas (docs/12 §4)
!tests/fixtures/terceiros/**/*.pdf
# Exportações claras e amostras privadas
exports/
amostras_privadas/
private/
# Segredos e logs
.env
.env.*
*.log
logs/

# ── Editores e sistema operacional ─────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Claude Code ────────────────────────────────────────
.claude/settings.local.json

