# Copy to .env and adjust (docs/20 §3). .env is not versioned.

# Domain that points to this machine. "localhost" uses Caddy's local certificate (testing only).
OPESVAULT_DOMAIN=localhost

# Ports published on the host. Keep 80 and 443 for a real domain (certificate issuance needs them).
OPESVAULT_HTTP_PORT=80
OPESVAULT_HTTPS_PORT=443

# Optional: the server secret (at least 32 characters). Leave empty to have one generated in the
# data volume on first start. Login salts depend on it: keep it with your backups.
OPESVAULT_SECRET=
